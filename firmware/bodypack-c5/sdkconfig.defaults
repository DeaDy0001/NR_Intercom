# NR_Intercom Bodypack - ESP32-C5 (Funk + Audio)
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Konsole ueber USB (UART0 bleibt frei)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 1-ms-Tick fuer Audio-Timing
CONFIG_FREERTOS_HZ=1000

# WLAN: Roaming-Funktionen
CONFIG_ESP_WIFI_11KV_SUPPORT=y
CONFIG_ESP_WIFI_11R_SUPPORT=y
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y

# lwIP: genug Sockets und schnelle Antwort
CONFIG_LWIP_MAX_SOCKETS=10
CONFIG_LWIP_SO_RCVBUF=y

# RAM sparen (kein PSRAM auf dem ESP32-C5-Zero): ungenutzte Treiber nicht ins IRAM legen
CONFIG_ANA_CMPR_ISR_HANDLER_IN_IRAM=n
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=n
CONFIG_MCPWM_ISR_HANDLER_IN_IRAM=n
CONFIG_PARLIO_TX_ISR_HANDLER_IN_IRAM=n
CONFIG_PARLIO_RX_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=n
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n
CONFIG_LOG_IN_IRAM=n
# Schlafmodi werden nicht genutzt (WLAN-Stromsparen ist fuer geringe Latenz aus)
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_PM_SLP_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
# WLAN-Puffer: Sprache braucht wenig Bandbreite
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=24
# WLAN-Code im Flash statt IRAM (bei ~100 kleinen Paketen/s ohne messbaren Nachteil, spart RAM)
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
